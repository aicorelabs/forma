{
  "name": "forma",
  "version": "1.0.0",
  "description": "FORMA — AI Graphic Design Studio",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "prisma generate && prisma migrate deploy",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:sans": "playwright test --grep \"\\[sans\\]\"",
    "test:serif": "playwright test --grep \"\\[serif\\]\"",
    "test:mono": "playwright test --grep \"\\[mono\\]\"",
    "test:parity": "playwright test --grep \"exported PNG ≈ native render\"",
    "test:validity": "playwright test --grep \"valid 1080\"",
    "test:debug": "playwright test --debug",
    "test:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "cloudinary": "^2.9.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "multer": "^2.1.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  }
}